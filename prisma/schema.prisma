generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessCenters BusinessCenter[]
  users           User[]
}

model BusinessCenter {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId String
  branch   Branch         @relation(fields: [branchId], references: [id])
  stores   StoreProject[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SURVEY_STAFF")
  region    String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  assignedStores StoreProject[] @relation("PMStores")
  assignedTasks  Task[]         @relation("TaskAssignee")
  activities     Activity[]
  issues         Issue[]        @relation("IssueReporter")
  phaseNotes     PhaseNote[]    @relation("PhaseNoteAuthor")
  baselines      PhaseBaseline[] @relation("BaselineCreator")
  createdDeps    TaskDependency[] @relation("DepCreator")
  snapshots      ScheduleSnapshot[] @relation("SnapshotTaker")
  resources      Resource[]      @relation("ResourceUser")
  timeEntries    TimeEntry[]     @relation("TimeEntryUser")
  approvals      TimeEntry[]     @relation("TimeEntryApprover")
  phaseGates     Phase[]         @relation("PhaseGateApprover")
  reportSchedules ReportSchedule[] @relation("ReportScheduleCreator")
}

model StoreProject {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique
  address        String
  region         String?
  targetOpenDate DateTime?
  actualOpenDate DateTime?
  status         String    @default("PLANNING")
  progress       Int       @default(0)
  budget         Float?
  notes          String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pmId             String?
  pm               User?           @relation("PMStores", fields: [pmId], references: [id])
  businessCenterId String?
  bc               BusinessCenter? @relation(fields: [businessCenterId], references: [id])
  phases           Phase[]
  issues           Issue[]
  activities       Activity[]
  baselines        PhaseBaseline[]
  scheduleSnapshots ScheduleSnapshot[]
  resources        Resource[]
  reportSchedules  ReportSchedule[]
}

model Phase {
  id          String    @id @default(cuid())
  phaseNumber Int
  name        String
  description String?
  status      String    @default("NOT_STARTED")
  plannedStart DateTime?
  plannedEnd  DateTime?
  actualStart DateTime?
  actualEnd   DateTime?
  order       Int

  // Dependency tracking (FS | SS | FF | SF)
  dependencyType String  @default("FS")
  dependsOnId    String?
  lagDays        Int     @default(0)
  progressPct    Int     @default(0)

  // MS-Project-compatible constraint (ASAP/ALAP/MSO/MFO/SNET/SNLT/FNET/FNLT).
  // ASAP is the implicit default; explicit value lets the engine clamp dates.
  constraintType String?
  constraintDate DateTime?
  // Soft target. Engine emits a DEADLINE_MISSED warning if finish exceeds it.
  deadline       DateTime?

  // Stream 6 P1 — cost tracking. fixedCost is direct (not derived from
  // resource assignments). Computed totalCost = fixedCost + Σ assignment.cost.
  fixedCost          Float   @default(0)
  fixedCostAccrual   String  @default("PRORATED") // START | END | PRORATED

  // Stream 8 P3 — stage-gate workflow. Phase cannot transition to
  // COMPLETED unless gate is approved. `gateRequired` defaults true so
  // existing phases keep current behavior (admin approval = gate pass).
  gateRequired   Boolean   @default(false)
  gateApprovedAt DateTime?
  gateApproverId String?
  gateApprover   User?     @relation("PhaseGateApprover", fields: [gateApproverId], references: [id])

  storeId String
  store   StoreProject @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tasks   Task[]
  notes   PhaseNote[]

  dependsOn  Phase?  @relation("PhaseDep", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents Phase[] @relation("PhaseDep")

  // Multi-predecessor edges (preferred over legacy `dependsOnId`).
  predecessorLinks TaskDependency[] @relation("DepSucc")
  successorLinks   TaskDependency[] @relation("DepPred")

  // Resource assignments (Stream 4 P2)
  assignments ResourceAssignment[]
  // Timesheet entries (Stream 5 P1)
  timeEntries TimeEntry[]
}

// Multi-predecessor dependency edge (Phase ↔ Phase).
// `lagPercent` overrides `lagDays` when non-null.
// `hard` = true → engine emits error if violated; false → warning only.
model TaskDependency {
  id            String  @id @default(cuid())
  predecessorId String
  successorId   String
  type          String  @default("FS") // FS | SS | FF | SF
  lagDays       Int     @default(0)
  lagPercent    Int?
  hard          Boolean @default(true)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  creator   User?    @relation("DepCreator", fields: [createdBy], references: [id])

  predecessor Phase @relation("DepPred", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Phase @relation("DepSucc", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
}

// Quick text notes attached to a specific phase (for daily logging like
// "rain delayed construction 3 days", "vendor late on delivery").
// Lighter than Issues — no severity/status workflow, just text + author + date.
model PhaseNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phaseId   String
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("PhaseNoteAuthor", fields: [authorId], references: [id])
}

// Snapshot đông cứng plannedStart/plannedEnd của tất cả 11 phase tại 1 thời điểm,
// để đối chiếu sau này ("Trễ 12 ngày so với Kế hoạch ban đầu").
model PhaseBaseline {
  id        String   @id @default(cuid())
  name      String                                            // "Kế hoạch ban đầu", "Sau ký HĐ"
  createdAt DateTime @default(now())

  storeId   String
  store     StoreProject @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy String?
  creator   User?        @relation("BaselineCreator", fields: [createdBy], references: [id])
  snapshots PhaseBaselineSnapshot[]
}

model PhaseBaselineSnapshot {
  id           String    @id @default(cuid())
  phaseNumber  Int                                            // 1..11
  plannedStart DateTime?
  plannedEnd   DateTime?
  // Stream 3 P3 — time-phased baseline (cost + work + progress at snapshot time).
  fixedCost    Float     @default(0)
  workHours    Float     @default(0)
  totalCost    Float     @default(0)
  progressPct  Int       @default(0)

  baselineId String
  baseline   PhaseBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@unique([baselineId, phaseNumber])
}

// Cấu hình mẫu cho các giai đoạn — admin có thể thêm/xóa/sắp xếp lại
// Áp dụng cho tất cả stores (cả cũ lẫn mới) khi thay đổi
model PhaseTemplate {
  id               String   @id @default(cuid())
  order            Int      @unique     // vị trí hiển thị (1-based, dynamic)
  defaultDepType   String   @default("FS")  // "FS" | "SS" | "FF" | "SF"
  defaultPredOrder Int?                     // null = auto (phase order-1); else explicit predecessor order
  defaultLagDays   Int      @default(0)
  name             String
  description      String?
  durationDays     Int                      // độ dài mặc định (ngày)
  taskTitles       String                   // JSON-encoded string[]
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  phaseId    String
  phase      Phase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  timeEntries TimeEntry[]
}

model Issue {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("ISSUE")
  severity    String   @default("MEDIUM")
  status      String   @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeId    String
  store      StoreProject @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?        @relation("IssueReporter", fields: [reporterId], references: [id])
}

// Stream 7 P3 — Scheduled report digests.
// Captures who wants which report on what cron + recipients. The cron
// runner + email transport land in P4; v1 stores config + lets users
// trigger a "run now" preview that returns the report payload.
model ReportSchedule {
  id          String   @id @default(cuid())
  name        String
  reportKind  String   @default("WEEKLY_SUMMARY") // WEEKLY_SUMMARY | COST_VARIANCE | RISK_DIGEST
  cron        String   // "0 9 * * 1" = Mon 9:00
  recipients  String   // JSON-stringified array of email addresses
  storeId     String?
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  creator     User?    @relation("ReportScheduleCreator", fields: [createdBy], references: [id])
  store       StoreProject? @relation(fields: [storeId], references: [id], onDelete: SetNull)
}

// Stream 5 P1 — Timesheet entries.
//
// One row per (user, phase, day, [optional task]). `hours` in decimal
// hours (0.25 step recommended). `status` reflects approval workflow.
model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  phaseId   String
  taskId    String?
  date      DateTime // anchored to UTC midnight
  hours     Float
  billable  Boolean  @default(true)
  notes     String?
  status    String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED

  submittedAt DateTime?
  approvedAt  DateTime?
  approverId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User  @relation("TimeEntryUser",     fields: [userId],     references: [id], onDelete: Cascade)
  approver User? @relation("TimeEntryApprover", fields: [approverId], references: [id])
  phase    Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  task     Task? @relation(fields: [taskId],  references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([phaseId])
}

// Stream 4 P2 — Resource + ResourceAssignment.
//
// `Resource.userId` is optional: a Resource can be a real User (PM, surveyor)
// or a generic role/material/cost item without a login (e.g. "Civil crew").
// `kind` distinguishes WORK / MATERIAL / COST per MS-Project semantics.
// `maxUnits` (% — 100 = 1 FTE) caps daily allocation for leveling.
// `standardRate` / `overtimeRate` priced per-hour; cost = units × hours × rate.
model Resource {
  id            String  @id @default(cuid())
  name          String
  kind          String  @default("WORK") // WORK | MATERIAL | COST
  email         String?
  group         String?
  maxUnits      Int     @default(100)
  standardRate  Float   @default(0)
  overtimeRate  Float   @default(0)
  costPerUse    Float   @default(0)

  storeId String?
  store   StoreProject? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?         @relation("ResourceUser", fields: [userId], references: [id])

  assignments ResourceAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([userId])
}

model ResourceAssignment {
  id          String  @id @default(cuid())
  resourceId  String
  phaseId     String
  units       Int     @default(100)
  workHours   Float   @default(0)
  actualWork  Float   @default(0)
  cost        Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  phase    Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([resourceId, phaseId])
  @@index([phaseId])
}

// Stream 2 P2: ScheduleSnapshot — frozen output of scheduler engine at a
// point in time. Lets us diff CP / dates between two runs.
model ScheduleSnapshot {
  id        String   @id @default(cuid())
  storeId   String
  takenAt   DateTime @default(now())
  reason    String?
  // Per-task array (id, name, start, finish, totalFloat, critical) as JSON.
  payload   String
  // SHA-256 of payload — quick equality test to skip duplicates.
  checksum  String

  takenBy   String?
  taker     User?         @relation("SnapshotTaker", fields: [takenBy], references: [id])
  store     StoreProject  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, takenAt])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  userId  String?
  user    User?        @relation(fields: [userId], references: [id])
  storeId String?
  store   StoreProject? @relation(fields: [storeId], references: [id])
}
